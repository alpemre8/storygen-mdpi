{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:storygen:architecture:1.0:dependency_lock",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "experiment_id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]*$",
      "maxLength": 80
    },
    "source_repositories": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "properties": {
          "repo_id": {
            "type": "string",
            "enum": [
              "storygen-rewrite",
              "storygen-feature-extraction",
              "storygen-evaluation",
              "storygen-naturalness"
            ]
          },
          "commit": {
            "type": "string",
            "pattern": "^[a-f0-9]{40}$"
          },
          "tree_sha256": {
            "type": "string",
            "pattern": "^sha256:[a-f0-9]{64}$"
          }
        },
        "required": [
          "repo_id",
          "commit",
          "tree_sha256"
        ],
        "additionalProperties": false
      }
    },
    "components": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "properties": {
          "component_id": {
            "type": "string",
            "minLength": 1
          },
          "version": {
            "type": "string",
            "minLength": 1
          },
          "repo_id": {
            "type": "string",
            "enum": [
              "storygen-rewrite",
              "storygen-feature-extraction",
              "storygen-evaluation",
              "storygen-naturalness"
            ]
          },
          "paths": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "minItems": 1,
            "uniqueItems": true
          },
          "sha256": {
            "type": "string",
            "pattern": "^sha256:[a-f0-9]{64}$"
          }
        },
        "required": [
          "component_id",
          "version",
          "repo_id",
          "paths",
          "sha256"
        ],
        "additionalProperties": false
      }
    },
    "assets": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "role": {
            "type": "string",
            "minLength": 1
          },
          "root_id": {
            "type": "string",
            "minLength": 1
          },
          "path": {
            "type": "string",
            "minLength": 1
          },
          "sha256": {
            "type": "string",
            "pattern": "^sha256:[a-f0-9]{64}$"
          }
        },
        "required": [
          "role",
          "root_id",
          "path",
          "sha256"
        ],
        "additionalProperties": false
      }
    },
    "models": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "alias": {
            "type": "string",
            "minLength": 1
          },
          "path": {
            "type": "string",
            "minLength": 1
          },
          "sha256": {
            "type": "string",
            "pattern": "^sha256:[a-f0-9]{64}$"
          },
          "quantization": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "alias",
          "path",
          "sha256",
          "quantization"
        ],
        "additionalProperties": false
      }
    },
    "runtime_profile": {
      "type": "object",
      "required": [
        "backend_commit",
        "profile_binding"
      ],
      "properties": {
        "backend_commit": {
          "type": "string",
          "pattern": "^[a-f0-9]{40}$"
        },
        "profile_binding": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": true
    },
    "environment": {
      "type": "object",
      "properties": {
        "python": {
          "type": "string",
          "minLength": 1
        },
        "packages": {
          "type": "object",
          "additionalProperties": {
            "type": "string",
            "minLength": 1
          }
        },
        "sha256": {
          "type": "string",
          "pattern": "^sha256:[a-f0-9]{64}$"
        }
      },
      "required": [
        "python",
        "packages",
        "sha256"
      ],
      "additionalProperties": false
    },
    "scientific_invariants": {
      "type": "object",
      "minProperties": 1
    },
    "run_binding_policy": {
      "const": "EXACT_INPUT_MODEL_RUNTIME_HASHES_REQUIRED"
    }
  },
  "required": [
    "schema_version",
    "experiment_id",
    "source_repositories",
    "components",
    "assets",
    "models",
    "runtime_profile",
    "environment",
    "scientific_invariants",
    "run_binding_policy"
  ],
  "additionalProperties": false
}
