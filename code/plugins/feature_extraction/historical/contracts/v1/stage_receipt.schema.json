{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:storygen:architecture:1.0:stage_receipt",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "run_id": {
      "type": "string",
      "minLength": 1
    },
    "experiment_id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]*$",
      "maxLength": 80
    },
    "stage_id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]*$",
      "maxLength": 80
    },
    "provider_repo": {
      "type": "string",
      "enum": [
        "storygen-rewrite",
        "storygen-feature-extraction",
        "storygen-evaluation",
        "storygen-naturalness"
      ]
    },
    "status": {
      "enum": [
        "RUNNING",
        "COMPLETE",
        "FAILED"
      ]
    },
    "started_utc": {
      "type": "string",
      "minLength": 1
    },
    "finished_utc": {
      "type": [
        "string",
        "null"
      ]
    },
    "input_sha256": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "outputs": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "producer_repo": {
            "type": "string",
            "enum": [
              "storygen-rewrite",
              "storygen-feature-extraction",
              "storygen-evaluation",
              "storygen-naturalness"
            ]
          },
          "producer_experiment": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]*$",
            "maxLength": 80
          },
          "protocol_id": {
            "type": "string",
            "minLength": 1
          },
          "producer_run_id": {
            "type": "string",
            "minLength": 1
          },
          "artifact_role": {
            "type": "string",
            "minLength": 1
          },
          "sha256": {
            "type": "string",
            "pattern": "^sha256:[a-f0-9]{64}$"
          },
          "schema_id": {
            "type": "string",
            "minLength": 1
          },
          "locator": {
            "type": "object",
            "properties": {
              "root_id": {
                "type": "string",
                "minLength": 1
              },
              "relative_path": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "root_id",
              "relative_path"
            ],
            "additionalProperties": false
          }
        },
        "required": [
          "producer_repo",
          "producer_experiment",
          "protocol_id",
          "producer_run_id",
          "artifact_role",
          "sha256",
          "schema_id",
          "locator"
        ],
        "additionalProperties": false
      }
    },
    "command": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "elapsed_seconds": {
      "type": "number",
      "minimum": 0
    },
    "error": {
      "type": [
        "string",
        "null"
      ]
    }
  },
  "required": [
    "schema_version",
    "run_id",
    "experiment_id",
    "stage_id",
    "provider_repo",
    "status",
    "started_utc",
    "finished_utc",
    "input_sha256",
    "outputs",
    "command",
    "elapsed_seconds",
    "error"
  ],
  "additionalProperties": false
}
