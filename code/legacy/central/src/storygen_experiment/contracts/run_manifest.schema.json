{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "storygen.central-run/1.0"
    },
    "experiment_id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]{0,79}$"
    },
    "group_id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]{0,79}$"
    },
    "protocol_id": {
      "type": "string",
      "minLength": 1
    },
    "protocol_version": {
      "type": "string",
      "minLength": 1
    },
    "run_id": {
      "type": "string",
      "minLength": 1
    },
    "owner_repo": {
      "const": "storygen-experiment"
    },
    "purpose": {
      "enum": [
        "SYNTHETIC_TEST",
        "MIGRATION_VERIFICATION",
        "RESEARCH"
      ]
    },
    "scientific_validity": {
      "enum": [
        "UNVERIFIED",
        "LIMITED"
      ]
    },
    "execution_status": {
      "enum": [
        "COMPLETE",
        "FAILED",
        "INTERRUPTED"
      ]
    },
    "contract_status": {
      "enum": [
        "VALID",
        "INVALID"
      ]
    },
    "started_utc": {
      "type": "string",
      "minLength": 1
    },
    "finished_utc": {
      "type": "string",
      "minLength": 1
    },
    "run_lock_sha256": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "runner": {
      "type": "object"
    },
    "providers": {
      "type": "array",
      "items": {
        "type": "object"
      },
      "minItems": 0
    },
    "inputs": {
      "type": "array",
      "items": {
        "type": "object"
      },
      "minItems": 0
    },
    "stages": {
      "type": "array",
      "items": {
        "type": "object"
      },
      "minItems": 0
    },
    "artifacts": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "artifact_id": {
            "type": "string",
            "pattern": "^sha256:[0-9a-f]{64}$"
          },
          "role": {
            "type": "string",
            "minLength": 1
          },
          "schema_id": {
            "type": "string",
            "minLength": 1
          },
          "sha256": {
            "type": "string",
            "pattern": "^sha256:[0-9a-f]{64}$"
          },
          "relative_path": {
            "type": "string",
            "minLength": 1
          },
          "producer": {
            "type": "string",
            "minLength": 1
          },
          "bytes": {
            "type": "integer",
            "minimum": 0
          }
        },
        "required": [
          "artifact_id",
          "role",
          "schema_id",
          "sha256",
          "relative_path",
          "producer",
          "bytes"
        ],
        "additionalProperties": false
      },
      "minItems": 0
    },
    "errors": {
      "type": "array",
      "items": {
        "type": "object"
      },
      "minItems": 0
    },
    "parent_run_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 0
    },
    "storage": {
      "type": "object",
      "properties": {
        "raw_backed_up": {
          "const": false
        },
        "metadata_git": {
          "const": true
        },
        "policy": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "raw_backed_up",
        "metadata_git",
        "policy"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "schema_version",
    "experiment_id",
    "group_id",
    "protocol_id",
    "protocol_version",
    "run_id",
    "owner_repo",
    "purpose",
    "scientific_validity",
    "execution_status",
    "contract_status",
    "started_utc",
    "finished_utc",
    "run_lock_sha256",
    "runner",
    "providers",
    "inputs",
    "stages",
    "artifacts",
    "errors",
    "parent_run_ids",
    "storage"
  ],
  "additionalProperties": false
}
